{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "stem"],
  "properties": {
    "type": { "enum": ["single_choice", "multiple_choice", "coding", "subjective"] },
    "title": { "type": "string" },
    "stem": { "type": "string" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "content"],
        "properties": {
          "key": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "answer": { "type": "array", "items": { "type": "string" } },
    "explanation": { "type": "string" },
    "images": {
      "type": "array",
      "items": { "type": "string" },
      "description": "题目附图 URL 列表，如 /api/media/question_images/1/fig.png"
    },
    "language": { "enum": ["python", "java", "c", "cpp"] },
    "metadata": {
      "type": "object",
      "properties": {
        "chapter": {
          "type": "string",
          "description": "用户手动维护的章节编号，如 6.1.6、§7.2"
        }
      }
    }
  }
}
